{
  "expo": {
    "name": "My Hero",
    "slug": "adam",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "myhero",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FF7A45"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.myhero.kids"
    },
    "android": {
      "package": "com.myhero.kids"
    },
    "web": {
      "favicon": "./assets/images/icon.png",
      "name": "My Hero – Kids Learning",
      "shortName": "My Hero",
      "description": "AI-powered bilingual learning companion for kids aged 3–15. English & Arabic, homework help, stories & games.",
      "themeColor": "#FF7A45",
      "backgroundColor": "#1e0a4a",
      "display": "standalone",
      "orientation": "portrait",
      "lang": "en",
      "scope": "/",
      "startUrl": "/",
      "preferRelatedApplications": false
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
