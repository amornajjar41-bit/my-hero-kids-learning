{
  "version": 2,
  "installCommand": "pnpm install --no-frozen-lockfile --ignore-scripts",
  "buildCommand": "pnpm run build",
  "functions": {
    "dist/vercel.mjs": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/admin/weekly-report",
      "schedule": "0 9 * * 0"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/dist/vercel.mjs"
    }
  ]
}
