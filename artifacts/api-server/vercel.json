{
  "version": 2,
  "installCommand": "pnpm install --no-frozen-lockfile --ignore-scripts",
  "buildCommand": "pnpm run build",
  "functions": {
    "dist/vercel.mjs": {
      "memory": 512,
      "maxDuration": 30
    }
  },
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/dist/vercel.mjs"
    }
  ]
}
