# ─────────────────────────────────────────────────────────────────────────────
# My Hero — Environment Variables Example
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── API Server (artifacts/api-server) ────────────────────────────────────────

# PostgreSQL connection string (Replit built-in DB or your own Postgres)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# OpenAI API key (used for AI chat, cache generation)
# Get yours at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# AssemblyAI API key (used for speech-to-text)
# Get yours at https://www.assemblyai.com/
ASSEMBLYAI_API_KEY=

# Google Cloud TTS API key (used for text-to-speech with WaveNet voices)
# Enable "Cloud Text-to-Speech API" at https://console.cloud.google.com/
GOOGLE_TTS_API_KEY=

# Supabase credentials (used for file/audio storage only — NOT as primary DB)
# Get yours at https://supabase.com/dashboard
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=eyJ...

# Express session secret (generate a random 32+ char string)
SESSION_SECRET=change-me-to-a-long-random-string

# Server port (Replit sets this automatically; leave blank for local dev default 8080)
PORT=8080

# ── Expo Mobile App (artifacts/adam) ─────────────────────────────────────────

# Public domain used by the Expo app to reach the API server
# In Replit this is set automatically; for local dev use your ngrok/tunnel URL
EXPO_PUBLIC_DOMAIN=your-replit-app.replit.app

# Supabase public credentials (safe to expose — anon key only)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# ─────────────────────────────────────────────────────────────────────────────
# Replit-managed AI integrations (auto-injected when using Replit AI integrations)
# These are set automatically — do NOT set them manually.
# ─────────────────────────────────────────────────────────────────────────────
# AI_INTEGRATIONS_OPENAI_API_KEY=  (auto-injected)
# AI_INTEGRATIONS_OPENAI_BASE_URL= (auto-injected)
